# =============================================================================
# Supabase to MongoDB Capacity Migration — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Supabase Database Connection (required) ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_HOST=           # From Supabase dashboard → Settings → Database → Host
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# --- Supabase Capacity (required) ---
# Maximum database size in bytes. Set this to match your compute tier.
# Free plan:  500 * 1024 * 1024 = 524288000  (500 MB)
# Micro:      10 * 1024 * 1024 * 1024 = 10737418240  (10 GB)
SUPABASE_MAX_DB_SIZE_BYTES=524288000

# --- MongoDB Connection (required) ---
MONGODB_URI=
MONGODB_DATABASE=

# --- Thresholds (optional — defaults shown) ---
START_THRESHOLD=90          # Start migration when Supabase usage >= this %
TARGET_THRESHOLD=50         # Stop migration when Supabase usage <= this %
BATCH_SIZE=500              # Records per batch

# --- Retry (optional — defaults shown) ---
MAX_RETRIES=3
RETRY_DELAY_SECONDS=10

# --- Feature Flags (optional — defaults shown) ---
MIGRATION_ENABLED=true      # Set to false for emergency stop
DRY_RUN=false               # Set to true for test runs (no deletions)

# --- AI (optional) ---
AI_ENABLED=false
AI_PROVIDER=                # openai | anthropic | gemini | openrouter
AI_API_KEY=
AI_MODEL=
